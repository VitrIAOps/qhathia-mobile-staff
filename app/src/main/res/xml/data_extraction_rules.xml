<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ backup and device-to-device transfer. Nothing of the app is worth restoring: the
    catalog, the orders and the settings live on the server, and a restored refresh token would be a
    session moved to another phone. Device transfer ignores allowBackup, so every domain is excluded
    here as well. A restored phone starts signed out.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
