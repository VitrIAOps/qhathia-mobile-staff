    <string name="statistics_top_sellers_title">Lo que más vende</string>
    <plurals name="statistics_top_sellers_caption">
        <item quantity="one">Generados por tu producto principal</item>
        <item quantity="other">Generados por tus %1$d productos principales</item>
    </plurals>
    <!-- %1$d listed, %2$d products that sold (picks the plural), %3$s listed revenue, %4$s the period's revenue. -->
    <plurals name="statistics_top_sellers_caption_share">
        <item quantity="one">Top %1$d de %2$d producto · %3$s de %4$s</item>
        <item quantity="other">Top %1$d de %2$d productos · %3$s de %4$s</item>
    </plurals>
    <!-- After the name of a top seller deleted since it sold. -->
    <string name="statistics_product_deleted">Eliminado</string>
