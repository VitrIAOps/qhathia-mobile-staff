    <plurals name="statistics_units_sold">
        <item quantity="one">%1$d vendido</item>
        <item quantity="other">%1$d vendidos</item>
    </plurals>
    <!-- Announced for a whole top-seller row: "1. Taladro, 34 vendidos, S/ 1,870". -->
    <string name="statistics_top_seller_row_cd">%1$d. %2$s, %3$s, %4$s</string>

