        <item quantity="one">Inmovilizados en %1$d de %2$d producto con stock sin ventas</item>
        <item quantity="other">Inmovilizados en %1$d de los %2$d productos con stock sin ventas</item>
    </plurals>
    <string name="statistics_needs_attention_empty">Todo tu inventario se movió en este periodo.</string>
    <plurals name="statistics_units_unsold">
        <item quantity="one">%1$d unidad sin vender</item>
        <item quantity="other">%1$d unidades sin vender</item>
    </plurals>
