    <string name="home_out_of_stock">Sin existencias</string>

    <!-- Loading / error -->
    <string name="home_loading_cd">Cargando el resumen</string>
    <string name="home_error_message">No pudimos actualizar el resumen.</string>
    <string name="home_retry">Reintentar</string>
